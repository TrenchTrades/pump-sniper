# Live trading. Set true to simulate without real SOL.
PAPER_MODE=false

# Live mode only. Use a paid RPC (Helius/QuickNode) and a BURNER wallet's base58 private key.
RPC_URL=
PRIVATE_KEY=

# Risk profile to start in: medium or high
RISK_PROFILE=medium

# Auto-scale between medium and high based on recent results in the current mode
AUTO_SCALE=true
SCALE_WINDOW_TRADES=20       # judge on the last N closed trades
SCALE_MIN_TRADES=20          # no switching until this many trades exist
SCALE_UP_WINRATE_PCT=50      # medium -> high when win rate >= this AND net PnL > 0
SCALE_DOWN_WINRATE_PCT=40    # high -> medium when win rate < this OR net PnL <= 0
SCALE_DOWN_DRAWDOWN_SOL=0.3  # high -> medium right away if it loses this much since scaling up

# Position size and daily loss cap per profile (in SOL)
MEDIUM_BUY_SOL=0.05
MEDIUM_DAILY_LOSS_SOL=0.3
HIGH_BUY_SOL=0.10
HIGH_DAILY_LOSS_SOL=0.75

MAX_WATCH=25
EST_ROUND_TRIP_FEE_PCT=3     # used for PnL estimates only

# ---------- speed ----------
JITO=true                                            # also send each trade as a Jito bundle
JITO_URL=https://ny.mainnet.block-engine.jito.wtf    # NY region, closest to a NYC droplet
JITO_TIP_SOL=0.0003                                  # tip per buy; sells pay tip x SELL_URGENCY
SELL_URGENCY=2                                       # sells pay 2x priority fee and tip to exit faster
MEDIUM_WINDOW_SEC=8                                  # seconds watched before buying (lower = faster, riskier)
HIGH_WINDOW_SEC=4

# ---------- filters ----------
MEDIUM_REQUIRE_SOCIALS=true    # set false if almost every token is dropped for "no socials"
HIGH_REQUIRE_SOCIALS=false

# Optional: only if PumpPortal asks for an API key for trade data
PUMPPORTAL_API_KEY=

# ---------- entry and stop tuning ----------
MEDIUM_MAX_GROWTH_PCT=100      # skip tokens whose price more than doubled while watching
HIGH_MAX_GROWTH_PCT=200
STOP_CONFIRM_SEC=1             # price must stay below the stop loss this long before selling
MEDIUM_HARD_STOP_PCT=35        # sell immediately, no waiting, at this loss
HIGH_HARD_STOP_PCT=50

# ---------- copy-trading ----------
STRATEGY=snipe                 # snipe = buy new launches; copy = copy the wallets below
COPY_WALLETS=                  # comma-separated wallet addresses to copy, e.g. AAA...,BBB...
COPY_BUY_SOL=0.03              # your size per copied trade
COPY_DAILY_LOSS_SOL=0.1        # stop copying for the day after this real loss
COPY_MAX_POSITIONS=3
COPY_MIN_LEADER_SOL=0.2        # ignore leader buys smaller than this (test buys, dust)
COPY_MAX_MCAP_SOL=800          # skip tokens already above this market cap (0 = off)
COPY_MIN_WALLETS=1             # require this many tracked wallets to buy the same token...
COPY_WINDOW_SEC=300            # ...within this many seconds
COPY_EXIT_ON_LEADER_SELL=true  # sell everything when the copied wallet sells
COPY_PUMP_ONLY=true            # only copy buys on the pump.fun bonding curve
COPY_STOP_LOSS_PCT=25          # safety exits in case the leader holds through a dump
COPY_HARD_STOP_PCT=40
COPY_TP1_PCT=100               # at +100%, sell COPY_TP1_SELL_PCT and trail the rest
COPY_TP1_SELL_PCT=50
COPY_TRAIL_PCT=30
COPY_MAX_HOLD_SEC=1800
COPY_PRIORITY_FEE_SOL=0.0003

# ---------- wallet scout (scout.py) ----------
BIRDEYE_API_KEY=               # from bds.birdeye.so, used by scout.py to find and check wallets
SCOUT_MIN_TRADES=30            # ignore wallets with fewer trades (luck)
SCOUT_MAX_TRADES=3000          # ignore wallets with more trades (bots you can't keep up with)
SCOUT_MIN_WINRATE=40
SCOUT_CHECK_TOP=25             # candidates looked up in detail per search
